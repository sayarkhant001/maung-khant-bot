# ─── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_ID=your_telegram_user_id
SUPPORT_USERNAME=@yoursupport

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Create a Google Service Account and download the JSON key
# Then base64 encode it: base64 -w 0 service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_json_here

# The ID from your Google Sheets URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# ─── Outline VPN (optional) ──────────────────────────────────────────────────
# From your Outline server's management API URL
OUTLINE_SERVER_API=https://your-outline-server.com:port/api-secret

# ─── Settings ────────────────────────────────────────────────────────────────
RATE_LIMIT_SECONDS=3
VPN_ORDER_EXPIRY_HOURS=24
MANUAL_ORDER_EXPIRY_HOURS=72
